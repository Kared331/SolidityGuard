# ═══════════════════════════════════════════════════════════════
# SolidGuard 环境变量配置
# 复制此文件为 .env 并修改所有 changeme 值
# ═══════════════════════════════════════════════════════════════
#
# ⚠ 重要（B1 教训）：
#   完整 DATABASE_URL / REDIS_URL 会覆盖下面的 POSTGRES_* / REDIS_*
#   组件变量。Docker 部署时 compose 用 POSTGRES_HOST=postgres 覆盖
#   localhost，若在此处写死完整 URL 则容器内仍连 localhost 必崩。
#   → 容器部署：保持下方 POSTGRES_*/REDIS_* 组件变量即可，勿写完整 URL
#   → 本地裸跑后端：可启用完整 URL（host=localhost）
#
# ⚠ 空值风险（P1-6）：
#   API_KEY 为空时服务可启动但全部业务请求 403（fail-closed）；
#   LLM_API_KEY 为空时 LLM 审计走降级落库（空 key 不崩但无真实审计）。
#   启动时 config.py 会打印一次性 WARNING 提示，生产使用前请务必填入真实 key。

# ── 基础配置 ───────────────────────────────────────────────────
API_KEY=changeme
APP_PORT=8000
LOG_LEVEL=INFO

# ── 数据库（POSTGRES_* 同时用于 docker postgres 服务和 URL 构建）──
POSTGRES_USER=solidguard
POSTGRES_PASSWORD=changeme
POSTGRES_DB=solidguard
# Docker 部署时 host 自动为 postgres，本地开发保持 localhost
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Redis（REDIS_* 用于 URL 构建）──────────────────────────────
REDIS_PASSWORD=changeme
REDIS_HOST=localhost
REDIS_PORT=6379

# ── LLM Provider ──────────────────────────────────────────────
# 在 solidguard.json 中配置 provider 的 baseUrl / model 等
# 这里只放 API Key（通过 ${LLM_API_KEY} 引用）
LLM_API_KEY=your-llm-api-key
# 可选：小米 Mimo provider
XIAOMI_API_KEY=

# ── 前端 ──────────────────────────────────────────────────────
VITE_API_BASE_URL=/api

# ── 可选 ──────────────────────────────────────────────────────
# GitHub token（SWC 同步限流用）
GITHUB_TOKEN=
