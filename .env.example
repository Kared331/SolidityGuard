# ═══════════════════════════════════════════════════════════════
# SolidGuard 环境变量配置
# 复制此文件为 .env 并修改所有 changeme 值
# ═══════════════════════════════════════════════════════════════

# ── 基础配置 ───────────────────────────────────────────────────
API_KEY=changeme
APP_PORT=8000
LOG_LEVEL=INFO

# ── 数据库（POSTGRES_* 同时用于 docker postgres 服务和 URL 构建）──
POSTGRES_USER=solidguard
POSTGRES_PASSWORD=changeme
POSTGRES_DB=solidguard
# Docker 部署时 host 自动为 postgres，本地开发保持 localhost
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Redis（REDIS_* 用于 URL 构建）──────────────────────────────
REDIS_PASSWORD=changeme
REDIS_HOST=localhost
REDIS_PORT=6379

# ── LLM Provider ──────────────────────────────────────────────
# 在 solidguard.json 中配置 provider 的 baseUrl / model 等
# 这里只放 API Key（通过 ${LLM_API_KEY} 引用）
LLM_API_KEY=your-llm-api-key
# 可选：小米 Mimo provider
XIAOMI_API_KEY=

# ── 前端 ──────────────────────────────────────────────────────
VITE_API_BASE_URL=/api

# ── 可选 ──────────────────────────────────────────────────────
# GitHub token（SWC 同步限流用）
GITHUB_TOKEN=
